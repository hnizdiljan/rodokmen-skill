---
import Base from '../layouts/Base.astro';
import { issues, config } from '../lib/data.js';
import IssueCard from '../components/IssueCard.astro';
import { Content as Dotazy } from '../generated/dotazy.md';
---
<Base title="Co hledáme">
  <h1>Co ještě hledáme</h1>
  <p class="lead">Otevřené otázky a hypotézy. Pokud o něčem z toho víte z rodinné paměti nebo dokumentů, ozvěte se{config.kontakt?.email ? <> na <a href={`mailto:${config.kontakt.email}`}>{config.kontakt.email}</a></> : ' autorovi rodokmenu'}.
    U otázek je i seznam „Už prověřeno“ – kde jsme už marně hledali, aby se hledání neopakovalo.</p>
  <h2>Otevřené otázky</h2>
  <div class="grid2">
    {issues.filter((i) => !i.text.startsWith('Vyřešeno')).map((i) => <IssueCard i={i} />)}
  </div>
  <h2>Prameny mimo online matriky</h2>
  <div class="prose small"><Dotazy /></div>
  <p><a href="/denik/">Výzkumný deník – všechna hledání včetně neúspěšných →</a></p>
</Base>
